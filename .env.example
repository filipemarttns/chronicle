CHRONICLE_ENV=local
CHRONICLE_AUTH_MODE=dev
CHRONICLE_STORE=memory
CHRONICLE_SYNC_PROJECT=true
CHRONICLE_BOOTSTRAP_TOKEN=bootstrap-change-me
CHRONICLE_AUTH_PEPPER=change-me-pepper
CHRONICLE_EMBEDDING_DIMS=384
CHRONICLE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://chronicle:chronicle@localhost:5432/chronicle
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
EMBEDDING_PROVIDER=hashing
NEXT_PUBLIC_CHRONICLE_API_URL=http://localhost:8000
NEXT_PUBLIC_CHRONICLE_API_TOKEN=
